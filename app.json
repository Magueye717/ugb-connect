{
  "expo": {
    "name": "UGB Connect",
    "slug": "ugb-campus",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "ugbconnect",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.ugbconnect.app"
    },
    "android": {
      "googleServicesFile": "./google-services.json",
      "adaptiveIcon": {
        "backgroundColor": "#FFFFFF",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "android.permission.CAMERA",
        "android.permission.VIBRATE",
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_FINE_LOCATION"
      ],
      "package": "com.ugbconnect.app",
      "blockedPermissions": [
        "android.permission.RECORD_AUDIO"
      ]
    },
    "web": {
      "bundler": "metro",
      "output": "server",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#0F1B4C"
        }
      ],
      [
        "expo-notifications",
        {
          "color": "#0F1B4C"
        }
      ],
      "expo-web-browser",
      "expo-image",
      [
        "expo-camera",
        {
          "cameraPermission": "La caméra sert à scanner une carte étudiant trouvée pour prévenir son propriétaire."
        }
      ],
      [
        "expo-image-picker",
        {
          "cameraPermission": "La caméra sert à photographier un objet perdu ou trouvé, ta carte étudiant, un plat, un article ou un lieu.",
          "photosPermission": "Tes photos illustrent un objet perdu ou trouvé, ta boutique, un plat, un article ou un lieu."
        }
      ],
      "expo-secure-store",
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Ta position sert à placer ton commerce sur la carte du campus."
        }
      ],
      [
        "expo-audio",
        {
          "enableBackgroundPlayback": false,
          "microphonePermission": false
        }
      ],
      "expo-asset"
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {
        "asyncRoutes": {
          "web": true
        }
      },
      "eas": {
        "projectId": "8a884c7a-efc3-44c3-846f-7cfbd25445be"
      }
    },
    "owner": "mggdev"
  }
}
